<launch>

    <!-- Both nodes read VEHICLE_NAME and USER_NAME from the environment.
         USER_NAME is used here only to give the node a unique name, so that
         several people can run their own control_room at the same time. -->
    <arg name="user" default="$(env USER_NAME)"/>

    <node pkg="control_room" exec="main.py" name="control_room_$(var user)"
          output="screen"/>

</launch>
